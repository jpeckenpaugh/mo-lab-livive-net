# Copy to .env for local development. These are development-only values, not secrets.
# Never commit .env (it is gitignored).

# Docker Compose stack (compose.yaml)
POSTGRES_USER=modelops
POSTGRES_PASSWORD=modelops
POSTGRES_DB=modelops
POSTGRES_PORT=5432
MLFLOW_PORT=5001
# Published port for the FastAPI inference service (`docker compose up -d --wait`).
API_PORT=8000
# Named Docker volume holding MLflow artifacts. `docker compose down -v` deletes it.
MLFLOW_ARTIFACT_VOLUME=modelops-lab-mlflow-artifacts

# MLflow tracking destination. Export this (or pass --tracking-uri) to override
# tracking.uri in configs/training.yaml. A copied .env is not read by the MLflow
# client automatically; `set -a; source .env; set +a` exports it.
MLFLOW_TRACKING_URI=http://localhost:5001

# Python runtime settings (read from .env by pydantic-settings).
MODELOPS_DATABASE_URL=postgresql+psycopg://modelops:modelops@localhost:5432/modelops
MODELOPS_MLFLOW_TRACKING_URI=http://localhost:5001
MODELOPS_ARTIFACT_ROOT=./artifacts
# `modelops serve` bind port; API_PORT controls the Compose published port.
MODELOPS_APP_PORT=8000
# Prediction events older than this are pruned by `modelops events prune`.
MODELOPS_EVENT_RETENTION_DAYS=30
